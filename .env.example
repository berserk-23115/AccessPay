# Copy to apps/web/.env.local for local development.
APP_BASE_URL=http://localhost:3000
# Required for production, at least 32 random characters. Optional locally.
SESSION_SECRET=
# Hosted production requires managed PostgreSQL. Local development uses durable PGlite.
DATABASE_URL=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Server-only Groq key. Required for the assistant; common merchant-fact answers work without it.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
# Production must explicitly enable the shared demo account and choose its password.
ALLOW_DEMO_AUTH=false
DEMO_ACCOUNT_PASSWORD=
# Server-to-server demo merchant endpoint; never expose in browser code.
MERCHANT_API_KEY=
